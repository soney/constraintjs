{
	"name": "constraintjs",
	"version": "0.10.0",
	"description": "Constraint library for JavaScript",
	"keywords": [
		"constraints",
		"reactive",
		"dataflow",
		"templates",
		"state machine"
	],
	"author": "Stephen Oney <swloney@gmail.com> (http://from.so/)",
	"homepage": "https://soney.github.io/constraintjs/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soney/constraintjs.git"
	},
	"bugs": "https://github.com/soney/constraintjs/issues",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"unpkg": "./dist/constraintjs.global.min.js",
	"jsdelivr": "./dist/constraintjs.global.min.js",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.18",
			"onFail": "warn"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs": "typedoc",
		"pages": "npm run build && npm run docs && node scripts/update-pages.mjs",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
		"prepublishOnly": "npm run check && npm run build"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.0",
		"@vitest/coverage-v8": "^5.0.2",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.2"
	}
}
